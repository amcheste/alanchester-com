---
import Monogram from './Monogram.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: '/writing', label: 'Writing', match: /^\/writing/ },
  { href: '/projects', label: 'Projects', match: /^\/projects/ },
  { href: '/about', label: 'About', match: /^\/about/ },
] as const;

const isActive = (re: RegExp) => re.test(path);
---

<header
  class:list={[
    'sticky top-0 z-50 w-full border-b border-mist/60 bg-paper/80 backdrop-blur',
    'dark:border-graphite/60 dark:bg-ink/80',
    className,
  ]}
>
  <nav class="mx-auto flex h-16 max-w-projects items-center justify-between px-6">
    <a href="/" class="no-underline" aria-label="Home">
      <Monogram size="md" />
    </a>

    <div class="hidden items-center gap-8 md:flex">
      {links.map(({ href, label, match }) => (
        <a
          href={href}
          class:list={[
            'font-mono text-sm no-underline transition-colors',
            isActive(match)
              ? 'text-ink underline decoration-accent decoration-2 underline-offset-[6px] dark:text-paper'
              : 'text-graphite hover:text-accent dark:text-mist dark:hover:text-accent',
          ]}
        >{label}</a>
      ))}
      <ThemeToggle />
    </div>

    <div class="flex items-center gap-2 md:hidden">
      <ThemeToggle />
      <button
        id="nav-open"
        type="button"
        aria-label="Open menu"
        aria-controls="mobile-nav"
        aria-expanded="false"
        class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-mist text-ink dark:border-graphite dark:text-paper"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" class="h-4 w-4" aria-hidden="true">
          <path d="M4 7h16"></path>
          <path d="M4 12h16"></path>
          <path d="M4 17h16"></path>
        </svg>
      </button>
    </div>
  </nav>
</header>

<div
  id="mobile-nav"
  class="fixed inset-0 z-[60] hidden flex-col bg-paper px-6 py-6 dark:bg-ink md:hidden"
>
  <div class="flex items-center justify-between">
    <a href="/" class="no-underline" aria-label="Home">
      <Monogram size="md" />
    </a>
    <button
      id="nav-close"
      type="button"
      aria-label="Close menu"
      class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-mist text-ink dark:border-graphite dark:text-paper"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" class="h-4 w-4" aria-hidden="true">
        <path d="M6 6l12 12"></path>
        <path d="M18 6l-12 12"></path>
      </svg>
    </button>
  </div>

  <div class="mt-16 flex flex-col gap-6">
    {links.map(({ href, label, match }) => (
      <a
        href={href}
        class:list={[
          'font-mono text-2xl no-underline',
          isActive(match)
            ? 'text-ink underline decoration-accent decoration-2 underline-offset-[6px] dark:text-paper'
            : 'text-graphite hover:text-accent dark:text-mist dark:hover:text-accent',
        ]}
      >{label}</a>
    ))}
  </div>
</div>

<script is:inline>
  (function () {
    const openBtn = document.getElementById('nav-open');
    const closeBtn = document.getElementById('nav-close');
    const menu = document.getElementById('mobile-nav');
    if (!openBtn || !closeBtn || !menu) return;
    const open = () => {
      menu.classList.remove('hidden');
      menu.classList.add('flex');
      openBtn.setAttribute('aria-expanded', 'true');
      document.documentElement.style.overflow = 'hidden';
    };
    const close = () => {
      menu.classList.add('hidden');
      menu.classList.remove('flex');
      openBtn.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
    };
    openBtn.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.classList.contains('flex')) close();
    });
  })();
</script>
