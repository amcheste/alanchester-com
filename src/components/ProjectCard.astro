---
interface Props {
  name: string;
  href: string;
  stack: string[];
  status: 'ACTIVE' | 'EXPERIMENT' | 'TOOLING';
  description: string;
  class?: string;
}

const { name, href, stack, status, description, class: className } = Astro.props;

const statusClass =
  status === 'ACTIVE'
    ? 'text-accent'
    : 'text-muted';
---

<article
  class:list={[
    'group flex h-full flex-col border border-mist bg-paper p-6 transition-colors hover:border-accent dark:border-graphite dark:bg-ink dark:hover:border-accent',
    className,
  ]}
>
  <header class="flex items-start justify-between gap-4">
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      class="font-mono text-lg font-bold text-ink no-underline transition-colors group-hover:text-accent dark:text-paper"
    >{name}</a>
    <span class:list={['font-mono text-eyebrow tracking-eyebrow', statusClass]}>{status}</span>
  </header>

  <div class="mt-2 flex flex-wrap gap-x-3 font-mono text-xs text-muted">
    {stack.map((tag) => <span>{tag}</span>)}
  </div>

  <p class="mt-4 flex-1 text-graphite dark:text-mist">{description}</p>

  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    class="mt-6 inline-flex items-center gap-2 font-mono text-sm text-accent no-underline hover:underline"
  >
    github
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-3 w-3" aria-hidden="true">
      <path d="M7 17 17 7"></path>
      <path d="M8 7h9v9"></path>
    </svg>
  </a>
</article>
