---
import type { ProjectCategory, ProjectStatus } from '../data/projects';

interface Props {
  name: string;
  href: string;
  stack: string[];
  category: ProjectCategory;
  status: ProjectStatus;
  description: string;
  class?: string;
}

const { name, href, stack, category, status, description, class: className } = Astro.props;

// Status is the only field that earns the accent: green marks the projects
// under active development. Everything else (category, experiment status,
// the tech stack) stays muted.
const statusClass = status === 'active' ? 'text-accent' : 'text-muted';
---

<article
  class:list={[
    'group flex h-full flex-col border border-mist bg-paper p-6 transition-colors hover:border-accent dark:border-graphite dark:bg-ink dark:hover:border-accent',
    className,
  ]}
>
  <header class="flex items-start justify-between gap-4">
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      class="font-mono text-lg font-bold text-ink no-underline transition-colors group-hover:text-accent dark:text-paper"
    >{name}</a>
    <div class="flex shrink-0 flex-col items-end gap-1 font-mono text-eyebrow tracking-eyebrow">
      <span class={statusClass}>{status.toUpperCase()}</span>
      <span class="text-muted">{category.toUpperCase()}</span>
    </div>
  </header>

  <div class="mt-2 flex flex-wrap gap-x-3 font-mono text-xs text-muted">
    {stack.map((tag) => <span>{tag}</span>)}
  </div>

  <p class="mt-4 flex-1 text-graphite dark:text-mist">{description}</p>

  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    class="mt-6 inline-flex items-center gap-2 font-mono text-sm text-accent no-underline hover:underline"
  >
    github
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-3 w-3" aria-hidden="true">
      <path d="M7 17 17 7"></path>
      <path d="M8 7h9v9"></path>
    </svg>
  </a>
</article>
